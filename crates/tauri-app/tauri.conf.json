{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Agent Garden",
  "version": "0.1.0",
  "identifier": "dev.localagentgarden",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Local Agent Garden",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/**", "../assets/**", "../../assets/**"]
        }
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
